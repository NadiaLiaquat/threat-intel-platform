# All of these already have sane defaults baked into docker-compose.yml —
# copy to .env only if you want to override something.

# How often the collector runs the full pipeline.
TIP_COLLECTION_INTERVAL_MINUTES=15

# How long an indicator is kept before it's eligible for cleanup.
# (Not yet enforced by a scheduled job — see README "Not built".)
TIP_IOC_RETENTION_DAYS=30
